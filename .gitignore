# =============================================================================
# Repo-global ignores ONLY. Anything specific to a subproject lives in that
# subproject's own .gitignore, so its rules cannot leak across projects:
#   tracker/.gitignore                    (Python tracker package)
#   avatar/WireProbe/.gitignore           (.NET console probe)
#   avatar/HandForge.Avatar/.gitignore    (Unity project)
# Keep only genuinely cross-cutting patterns here.
# =============================================================================

# Tool caches — created in whatever directory the tool is invoked from, so they
# can show up at the repo root as well as inside a subproject.
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets / environment (defense-in-depth: never track these anywhere)
.env
.env.local
.env.dev
.env.test

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE / editor
.idea/
.vscode/
*.swo
*.user
*.sublime-project
*.sublime-workspace
