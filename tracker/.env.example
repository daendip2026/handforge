# Copy this file to .env and adjust values as needed.
# .env is gitignored. .env.example is committed.

# Pattern: HANDFORGE__<SECTION>__<KEY>

# --- Global ---
# HANDFORGE__CONFIG_PATH=config.yaml

# --- Camera ---
# HANDFORGE__CAMERA__INDEX=0
# HANDFORGE__CAMERA__WIDTH=640
# HANDFORGE__CAMERA__HEIGHT=480

# --- MediaPipe ---
# HANDFORGE__MEDIAPIPE__MIN_DETECTION_CONFIDENCE=0.7

# --- Transport (system/ADR-0001: UDP data / TCP control) ---
# HANDFORGE__TRANSPORT__UDP_HOST=127.0.0.1
# HANDFORGE__TRANSPORT__UDP_PORT=9000
# HANDFORGE__TRANSPORT__TCP_HOST=127.0.0.1
# HANDFORGE__TRANSPORT__TCP_PORT=9001

# --- Logging ---
# HANDFORGE__LOGGING__LEVEL=DEBUG
# HANDFORGE__LOGGING__CONSOLE_ENABLED=true
